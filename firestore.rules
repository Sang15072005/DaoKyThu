rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
  function active(){return signed() && me().data.active==true;}
  function teacher(){return active() && me().data.role=='teacher';}
  function student(){return active() && me().data.role=='student';}
  match /users/{uid} {
   allow read: if active() && (request.auth.uid==uid || (teacher() && resource.data.role=='student' && resource.data.teacherId==request.auth.uid));
   allow write: if false;
  }
  match /studentCodes/{code} {allow read,write: if false;}
  match /classes/{id} {
   allow read: if teacher() && resource.data.teacherId==request.auth.uid || student() && resource.data.teacherId==me().data.teacherId && resource.data.code==me().data.classCode;
   allow write: if false;
  }
  match /assignments/{id} {
   allow read: if teacher() && resource.data.teacherId==request.auth.uid || student() && resource.data.teacherId==me().data.teacherId && resource.data.classCode==me().data.classCode;
   allow write: if false;
  }
  match /progress/{id} {
   allow read: if student() && resource.data.studentId==request.auth.uid || teacher() && resource.data.teacherId==request.auth.uid;
   allow create: if student() && id.matches(request.auth.uid+'_(basic_[RBNQKP]|mate2_(5[2-9]|6[01])|mate3_16[2-7])') && request.resource.data.keys().hasOnly(['studentId','teacherId','exercise','completed','score','updatedAt']) && request.resource.data.studentId==request.auth.uid && request.resource.data.teacherId==me().data.teacherId && request.resource.data.exercise is string && request.resource.data.completed is bool && request.resource.data.score is number && request.resource.data.score>=0 && request.resource.data.score<=6;
   allow update: if student() && resource.data.studentId==request.auth.uid && resource.data.teacherId==me().data.teacherId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','score','updatedAt']) && request.resource.data.score is number && request.resource.data.score>=0 && request.resource.data.score<=6 && request.resource.data.completed is bool;
   allow delete: if false;
  }
  // Individual island progress, never shared with classroom room state.
  match /adventureProgress/{uid} {
   allow read: if active() && request.auth.uid==uid;
   allow create,update: if student() && request.auth.uid==uid
     && request.resource.data.keys().hasOnly(['studentId','done','forestDone','canyonDone','rewardedRegions','purchasedAvatars','stars','updatedAt'])
     && request.resource.data.studentId==uid
     && request.resource.data.done is list
     && request.resource.data.done.size()<=10
     && request.resource.data.forestDone is list
     && request.resource.data.forestDone.size()<=6
     && request.resource.data.canyonDone is list
     && request.resource.data.canyonDone.size()<=13
     && request.resource.data.rewardedRegions is list
     && request.resource.data.rewardedRegions.size()<=7
     // The launched areas are 1–3. Other regions cannot award coins yet.
     && request.resource.data.rewardedRegions.hasOnly([0,1,2])
     && request.resource.data.purchasedAvatars is list
     && request.resource.data.purchasedAvatars.size()<=3
     && request.resource.data.purchasedAvatars.hasOnly(['knight','queen','king'])
     // Owned characters must not disappear after refresh or concurrent saves.
     && (resource == null ||
       request.resource.data.purchasedAvatars.hasAll(resource.data.get('purchasedAvatars',[])))
     // The virtual shop never permits a negative balance.
     && ((('knight' in request.resource.data.purchasedAvatars) ? 3000 : 0)
         + (('queen' in request.resource.data.purchasedAvatars) ? 7000 : 0)
         + (('king' in request.resource.data.purchasedAvatars) ? 7000 : 0))
       <= ((0 in request.resource.data.rewardedRegions ? 1000 : 0)
         + (1 in request.resource.data.rewardedRegions ? 2000 : 0)
         + (2 in request.resource.data.rewardedRegions ? 3000 : 0))
     && request.resource.data.stars is int
     && request.resource.data.stars>=0
     && request.resource.data.stars<=105;
   allow delete: if false;
  }
  // Existing live classroom: restrict authenticated access. For production,
  // replace this with membership-aware rules before using real student data.
  match /rooms/{roomId} {
   allow read,create,update: if active();
   allow delete: if false;
  }
  match /{document=**} {allow read,write: if false;}
 }
}
